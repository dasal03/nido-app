{
  "expo": {
    "name": "Nido",
    "slug": "nido",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nido.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001C64",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nido.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nido usa tus fotos para tu foto de perfil.",
          "cameraPermission": "Nido usa la cámara para tu foto de perfil."
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nido usa Face ID para proteger tus ahorros."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nido usa la cámara para escanear el código QR de tu pareja y tomar tu foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A1F5C"
        }
      ]
    ],
    "scheme": "nido"
  }
}
